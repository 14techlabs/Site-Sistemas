@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --navy: #16202e;
  --navy2: #1c4f8f;
  --blue: #1c4f8f;
  --orange: #1c4f8f;
  --orangeSoft: #e8f0fb;
  --ink: #16202e;
  --muted: #667085;
  --line: #dfe3e8;
  --paper: #f5f6f8;
  --white: #fff;
  --shadow: 0 20px 60px rgba(22, 32, 46, .1);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--paper);
  color: var(--ink);
  font-family: 'DM Sans', ui-sans-serif, system-ui, sans-serif;
}

body, button, input, a {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

.page-shell {
  overflow: hidden;
}

.container {
  width: min(1180px, calc(100% - 40px));
  margin: auto;
}

.site-header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 20;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, .95);
  backdrop-filter: blur(18px);
}

.header-inner {
  display: flex;
  min-height: 78px;
  align-items: center;
  gap: 30px;
}

.brand {
  display: block;
  width: 160px;
}

.brand img {
  display: block;
  width: 100%;
  height: auto;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 22px;
  margin-left: auto;
  color: #52627b;
  font-size: 13px;
  font-weight: 600;
}

.desktop-nav > a:hover {
  color: var(--orange);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 47px;
  padding: 0 19px;
  border-radius: 7px;
  background: var(--orange);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  box-shadow: 0 9px 20px rgba(243, 107, 33, .2);
  transition: .2s;
}

.button:hover {
  background: #d95312;
  transform: translateY(-2px);
}

.button-light {
  background: #fff;
  color: var(--navy);
  box-shadow: 0 10px 25px rgba(0, 0, 0, .13);
}

.button-light:hover {
  background: #fff3ec;
}

.menu-toggle {
  display: none;
  margin-left: auto;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  border-radius: 7px;
  background: #fff;
  color: var(--navy);
}

.mobile-nav {
  display: none;
}

.hero {
  position: relative;
  padding: 170px 0 105px;
  background: linear-gradient(118deg, #f8fbff, #eef4fb);
  border-bottom: 1px solid var(--line);
}

.hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: 74px;
}

.hero-copy {
  max-width: 570px;
}

.kicker, .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--orange);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 20px 0 0;
  color: var(--navy);
  font-family: 'Manrope', sans-serif;
  font-size: clamp(2.7rem, 5.6vw, 5rem);
  line-height: 1.03;
  letter-spacing: -.055em;
}

.hero h1 em {
  color: var(--orange);
  font-style: normal;
}

.hero-lead {
  max-width: 535px;
  margin: 24px 0 0;
  color: #3c4f6c;
  font-size: 18px;
  line-height: 1.65;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 17px;
  margin-top: 31px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--navy);
  font-size: 13px;
  font-weight: 700;
}

.hero-proof {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 28px;
  color: var(--muted);
  font-size: 12px;
}

.hero-proof svg {
  color: var(--orange);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(243, 107, 33, .09);
}

.hero-glow-one {
  width: 430px;
  height: 430px;
  right: -150px;
  top: -180px;
}

.hero-glow-two {
  width: 180px;
  height: 180px;
  left: -100px;
  bottom: -100px;
  background: rgba(18, 79, 159, .08);
}

.print-window {
  overflow: hidden;
  min-height: 310px;
  border: 1px solid #d9e2ed;
  border-radius: 13px;
  background: #fff;
  box-shadow: var(--shadow);
}

.window-bar {
  display: flex;
  gap: 6px;
  padding: 13px 16px;
  border-bottom: 1px solid var(--line);
  background: #fbfcfe;
}

.window-bar i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #d5deea;
}

.window-bar i:first-child {
  background: #ffb58d;
}

.window-body {
  display: grid;
  align-content: center;
  min-height: 265px;
  padding: 30px;
  background: linear-gradient(135deg, #f8fbff, #eef5fb);
}

.window-label {
  color: var(--orange);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .15em;
}

.window-body strong {
  display: block;
  margin-top: 10px;
  color: var(--navy);
  font-family: 'Manrope', sans-serif;
  font-size: 25px;
}

.skeleton-row {
  display: flex;
  gap: 10px;
  margin-top: 27px;
}

.skeleton-row i {
  height: 45px;
  flex: 1;
  border-radius: 6px;
  background: #dbe8f5;
}

.skeleton-row i:first-child {
  background: #ffe2d1;
}

.skeleton-chart {
  display: flex;
  align-items: end;
  gap: 8px;
  height: 95px;
  margin-top: 25px;
  padding: 12px;
  border-radius: 8px;
  background: #fff;
}

.skeleton-chart i {
  flex: 1;
  height: 35%;
  border-radius: 4px 4px 0 0;
  background: #aec7e4;
}

.skeleton-chart i:nth-child(2) {
  height: 65%;
  background: #f6a77a;
}

.skeleton-chart i:nth-child(3) {
  height: 48%;
  background: #5b86bd;
}

.skeleton-chart i:nth-child(4) {
  height: 78%;
  background: var(--orange);
}

.skeleton-chart i:last-child {
  height: 58%;
  background: var(--blue);
}

.print-caption {
  display: block;
  margin-top: 11px;
  color: #8a97aa;
  font-size: 11px;
  text-align: center;
}

.section {
  padding: 105px 0;
}

.section-title {
  max-width: 720px;
  margin: 0 auto 46px;
  text-align: center;
}

.section-title-left {
  margin-left: 0;
  text-align: left;
}

.section-title h2 {
  margin: 13px 0 0;
  color: var(--navy);
  font-family: 'Manrope', sans-serif;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -.05em;
}

.section-title p {
  margin: 16px 0 0;
  color: var(--muted);
  line-height: 1.7;
}

.challenges, .features, .pncp, .advantages {
  background: #fff;
}

.challenge-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 13px;
}

.icon-card {
  min-width: 0;
  padding: 23px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #fff;
  box-shadow: 0 8px 25px rgba(7, 26, 66, .035);
  transition: .2s;
}

.icon-card:hover {
  border-color: #f5b28e;
  box-shadow: var(--shadow);
  transform: translateY(-3px);
}

.icon-box {
  display: grid;
  width: 43px;
  height: 43px;
  place-items: center;
  border-radius: 8px;
  background: var(--orangeSoft);
  color: var(--orange);
}

.icon-card h3 {
  margin: 18px 0 0;
  color: var(--navy);
  font-size: 15px;
  line-height: 1.35;
}

.icon-card p {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.65;
}

.about, .process, .integration {
  background: #eef4fb;
}

.about-grid, .process-grid {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: 80px;
}

.body-copy {
  max-width: 560px;
  color: #4b5d76;
  line-height: 1.8;
}

.module-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 25px;
}

.module-pills span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 12px;
  border: 1px solid #cbd9e9;
  border-radius: 5px;
  background: #fff;
  color: var(--navy);
  font-size: 12px;
  font-weight: 700;
}

.module-pills svg {
  color: var(--orange);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.feature-grid .icon-card {
  min-height: 174px;
}

.phase-list {
  display: grid;
  gap: 10px;
  margin-top: 27px;
}

.phase-list div {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 16px;
  border-left: 3px solid var(--orange);
  background: #fff;
}

.phase-list strong {
  min-width: 82px;
  color: var(--navy);
  font-family: 'Manrope', sans-serif;
}

.phase-list span {
  color: var(--muted);
  font-size: 13px;
}

.mini-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  margin-top: 25px;
}

.mini-flow span {
  padding: 10px 12px;
  border-radius: 5px;
  background: var(--orangeSoft);
  color: var(--navy);
  font-size: 12px;
  font-weight: 700;
}

.mini-flow i {
  color: var(--orange);
  font-style: normal;
}

.modules {
  background: var(--navy);
  color: #fff;
}

.modules .section-title h2 {
  color: #fff;
}

.modules .section-title p {
  color: rgba(255, 255, 255, .68);
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.module-grid > div {
  padding: 27px;
  border: 1px solid rgba(255, 255, 255, .14);
  border-radius: 9px;
  background: rgba(255, 255, 255, .07);
}

.module-grid svg {
  color: var(--orange);
}

.module-grid h3 {
  margin: 21px 0 13px;
  font-family: 'Manrope', sans-serif;
  font-size: 19px;
}

.module-grid ul {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
  color: rgba(255, 255, 255, .7);
  font-size: 13px;
  line-height: 1.5;
}

.module-grid li::before {
  margin-right: 8px;
  color: var(--orange);
  content: '•';
}

.integration-orbit {
  position: relative;
  width: min(570px, 100%);
  height: 300px;
  margin: 0 auto 60px;
}

.orbit-center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: grid;
  width: 105px;
  height: 105px;
  place-items: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: var(--navy);
  box-shadow: 0 0 0 14px rgba(243, 107, 33, .12);
}

.orbit-center img {
  width: 57px;
}

.orbit-item {
  position: absolute;
  padding: 11px 14px;
  border: 1px solid #c9d8e8;
  border-radius: 5px;
  background: #fff;
  color: var(--navy);
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 7px 15px rgba(7, 26, 66, .06);
}

.orbit-0 {
  top: 0;
  left: 45%;
}

.orbit-1 {
  top: 43px;
  right: 5%;
}

.orbit-2 {
  right: 0;
  bottom: 36px;
}

.orbit-3 {
  bottom: 0;
  left: 39%;
}

.orbit-4 {
  bottom: 36px;
  left: 0;
}

.orbit-5 {
  top: 43px;
  left: 4%;
}

.orbit-6 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) translateY(91px);
}

.flow-strip {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  border: 1px solid #cbd9e9;
  border-radius: 8px;
  background: #fff;
}

.flow-strip div {
  display: grid;
  gap: 7px;
  padding: 17px 12px;
  border-right: 1px solid var(--line);
}

.flow-strip div:last-child {
  border: 0;
}

.flow-strip b {
  color: var(--orange);
  font-size: 11px;
}

.flow-strip span {
  color: var(--navy);
  font-size: 12px;
  font-weight: 700;
}

.advantages-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 13px;
}

.cta {
  padding: 82px 0;
  background: linear-gradient(115deg, var(--navy), var(--navy2));
  color: #fff;
}

.cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 45px;
}

.cta h2 {
  max-width: 730px;
  margin: 16px 0 0;
  font-family: 'Manrope', sans-serif;
  font-size: clamp(2rem, 4vw, 3.5rem);
  line-height: 1.06;
  letter-spacing: -.05em;
}

.cta p {
  max-width: 620px;
  margin: 15px 0 0;
  color: rgba(255, 255, 255, .7);
}

.footer {
  padding: 30px 0;
  background: #04132f;
  color: #fff;
}

.footer-inner {
  display: flex;
  align-items: center;
  gap: 25px;
}

.footer img {
  width: 130px;
}

.footer span {
  color: rgba(255, 255, 255, .58);
  font-size: 12px;
}

.footer a {
  margin-left: auto;
  color: var(--orange);
  font-size: 12px;
  font-weight: 700;
}

@media (max-width: 1000px) {
  .desktop-nav {
    gap: 12px;
  }
  .challenge-grid, .advantages-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .feature-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .hero-grid, .about-grid, .process-grid {
    gap: 45px;
  }
  .flow-strip {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (max-width: 760px) {
  .container {
    width: min(100% - 30px, 580px);
  }
  .desktop-nav {
    display: none;
  }
  .menu-toggle {
    display: grid;
    place-items: center;
  }
  .mobile-nav {
    position: absolute;
    inset: 78px 15px auto;
    display: grid;
    gap: 4px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .mobile-nav > a {
    padding: 12px;
    color: var(--navy);
    font-size: 13px;
    font-weight: 600;
  }
  .mobile-nav .button {
    margin-top: 6px;
  }
  .hero {
    padding: 128px 0 70px;
  }
  .hero-grid, .about-grid, .process-grid {
    grid-template-columns: 1fr;
  }
  .hero h1 {
    font-size: clamp(2.45rem, 11vw, 4rem);
  }
  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }
  .hero-actions .button {
    width: max-content;
  }
  .section {
    padding: 75px 0;
  }
  .challenge-grid, .advantages-grid, .feature-grid, .module-grid {
    grid-template-columns: 1fr;
  }
  .flow-strip {
    grid-template-columns: repeat(2, 1fr);
  }
  .flow-strip div:nth-child(2n) {
    border-right: 0;
  }
  .flow-strip div {
    border-bottom: 1px solid var(--line);
  }
  .integration-orbit {
    height: 275px;
  }
  .orbit-item {
    font-size: 10px;
  }
  .cta-inner {
    align-items: flex-start;
    flex-direction: column;
  }
  .footer-inner {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }
  .footer a {
    margin-left: 0;
  }
  .print-window {
    min-height: 260px;
  }
  .window-body {
    min-height: 215px;
    padding: 22px;
  }
}

.button:hover {
  background: #123f75;
}

.hero-glow-one {
  background: rgba(28, 79, 143, .09);
}

.window-bar i:first-child {
  background: #9bb9dc;
}

.skeleton-row i:first-child {
  background: #dbe8f5;
}

.skeleton-chart i:nth-child(2), .skeleton-chart i:nth-child(4) {
  background: #6f9bcf;
}

.icon-card:hover {
  border-color: #9bb9dc;
}

.phase-list div {
  border-left-color: var(--blue);
}

.integration-orbit {
  height: auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
  margin: 0 auto 60px;
}

.integration-orbit .orbit-center {
  position: static;
  grid-column: 1 / -1;
  transform: none;
  margin: 0 auto 10px;
}

.integration-orbit .orbit-item {
  position: static;
  transform: none;
  padding: 12px 10px;
  text-align: center;
}

.integration-orbit .orbit-6 {
  transform: none;
}

@media (max-width: 760px) {
  .integration-orbit {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .integration-orbit .orbit-center {
    grid-column: 1 / -1;
  }
  .integration-orbit .orbit-item {
    font-size: 11px;
  }
  .flow-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Final product alignment: Inter everywhere and a radial integration map. */
html, body, body * {
  font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
}

.button-light:hover {
  background: #eef4fb;
}

.button:hover {
  background: #123f75;
}

.integration-orbit {
  position: relative;
  display: block;
  width: min(720px, 100%);
  height: 430px;
  margin: 0 auto 60px;
}

.integration-lines {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.integration-lines path {
  fill: none;
  stroke: #8eafd2;
  stroke-width: 2;
  marker-end: url(#suapre-arrow);
}

.integration-lines marker path {
  fill: #1c4f8f;
}

.integration-orbit .orbit-center {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  display: grid;
  width: 112px;
  height: 112px;
  place-items: center;
  margin: 0;
  transform: translate(-50%, -50%);
  border: 8px solid #e8f0fb;
  border-radius: 50%;
  background: #1c4f8f;
  box-shadow: 0 12px 30px rgba(28, 79, 143, .22);
}

.integration-orbit .orbit-center img {
  width: 58px;
}

.integration-orbit .orbit-item {
  position: absolute;
  z-index: 3;
  display: grid;
  min-width: 106px;
  place-items: center;
  padding: 12px 13px;
  border: 1px solid #c9d8e8;
  border-radius: 7px;
  background: #fff;
  color: #16202e;
  font-size: 12px;
  font-weight: 700;
  box-shadow: 0 7px 15px rgba(22, 32, 46, .08);
}

.integration-orbit .orbit-0 {
  top: 4px;
  left: 50%;
  transform: translateX(-50%);
}

.integration-orbit .orbit-1 {
  top: 69px;
  right: 60px;
}

.integration-orbit .orbit-2 {
  right: 8px;
  bottom: 69px;
}

.integration-orbit .orbit-3 {
  bottom: 4px;
  left: 50%;
  transform: translateX(-50%);
}

.integration-orbit .orbit-4 {
  bottom: 69px;
  left: 8px;
}

.integration-orbit .orbit-5 {
  top: 69px;
  left: 60px;
}

.integration-orbit .orbit-6 {
  top: 50%;
  right: 8px;
  transform: translateY(-50%);
}

@media (max-width: 760px) {
  .integration-orbit {
    height: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .integration-lines {
    display: none;
  }
  .integration-orbit .orbit-center {
    position: relative;
    top: auto;
    left: auto;
    grid-column: 1 / -1;
    transform: none;
    margin: 0 auto 12px;
  }
  .integration-orbit .orbit-item,
  .integration-orbit .orbit-0,
  .integration-orbit .orbit-1,
  .integration-orbit .orbit-2,
  .integration-orbit .orbit-3,
  .integration-orbit .orbit-4,
  .integration-orbit .orbit-5,
  .integration-orbit .orbit-6 {
    position: static;
    min-width: 0;
    transform: none;
  }
  .integration-orbit .orbit-item {
    font-size: 11px;
  }
}

.button {
  box-shadow: 0 9px 20px rgba(28, 79, 143, .2);
}

.hero-glow-one {
  background: rgba(28, 79, 143, .09);
}

.window-bar i:first-child {
  background: #9bb9dc;
}

.skeleton-row i:first-child {
  background: #dbe8f5;
}

.skeleton-chart i:nth-child(2), .skeleton-chart i:nth-child(4) {
  background: #6f9bcf;
}

.flow-details {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 28px;
}

.flow-details article {
  display: grid;
  grid-template-columns: 36px 1fr;
  gap: 13px;
  padding: 17px;
  border: 1px solid #cbd9e9;
  border-radius: 8px;
  background: #fff;
}

.flow-details article > span {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  background: #e8f0fb;
  color: #1c4f8f;
  font-size: 11px;
  font-weight: 800;
}

.flow-details strong {
  display: block;
  color: #16202e;
  font-size: 14px;
}

.flow-details p {
  margin: 5px 0 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.55;
}

.flow-details article:last-child {
  grid-column: 1 / -1;
}

@media (max-width: 760px) {
  .flow-details {
    grid-template-columns: 1fr;
  }
  .flow-details article:last-child {
    grid-column: auto;
  }
}

.process, .pncp {
  display: none;
}

.integration .flow-strip, .integration .flow-details {
  display: none;
}

.flow-section {
  background: #f5f6f8;
}

.flow-steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
}

.flow-steps article {
  position: relative;
  min-height: 150px;
  padding: 18px;
  border: 1px solid #cbd9e9;
  border-radius: 8px;
  background: #fff;
}

.flow-steps article > span {
  display: grid;
  width: 30px;
  height: 30px;
  place-items: center;
  border-radius: 50%;
  background: #e8f0fb;
  color: #1c4f8f;
  font-size: 11px;
  font-weight: 800;
}

.flow-steps strong {
  display: block;
  margin-top: 14px;
  color: #16202e;
  font-size: 14px;
}

.flow-steps p {
  margin: 6px 0 0;
  color: #667085;
  font-size: 12px;
  line-height: 1.5;
}

.flow-steps i {
  position: absolute;
  top: 50%;
  right: -19px;
  z-index: 2;
  color: #1c4f8f;
  font-size: 20px;
  font-style: normal;
}

.flow-steps article:nth-child(4) i {
  display: none;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1.3fr 1.1fr;
  gap: 35px;
  padding: 58px 0 42px;
}

.footer-brand img {
  display: block;
  width: 145px;
}

.footer-brand p {
  max-width: 260px;
  margin: 17px 0 0;
  color: rgba(255, 255, 255, .65);
  font-size: 12px;
  line-height: 1.65;
}

.footer h3 {
  margin: 0 0 14px;
  color: #9bb9dc;
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.footer-grid > a, .footer-grid > div > a, .footer-grid > div > span {
  display: block;
  margin-top: 10px;
  color: rgba(255, 255, 255, .68);
  font-size: 12px;
}

.footer-grid a:hover {
  color: #fff;
}

.footer-seal {
  display: flex;
  gap: 9px;
  align-items: flex-start;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 7px;
}

.footer-seal svg {
  flex: none;
  color: #9bb9dc;
}

.footer-seal span {
  color: rgba(255, 255, 255, .62);
  font-size: 11px;
  line-height: 1.45;
}

.footer-seal strong {
  display: block;
  color: #fff;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  padding: 17px 0;
  border-top: 1px solid rgba(255, 255, 255, .13);
  color: rgba(255, 255, 255, .45);
  font-size: 10px;
}

.footer {
  padding: 0;
}

.footer-inner {
  display: none;
}

@media (max-width: 760px) {
  .flow-steps {
    grid-template-columns: 1fr;
  }
  .flow-steps i {
    display: none !important;
  }
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 27px;
    padding: 42px 0 30px;
  }
  .footer-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }
}

.integration-map {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  max-width: 940px;
  margin: 0 auto;
  padding: 38px 34px;
  border: 1px solid #cbd9e9;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 15px 40px rgba(22, 32, 46, .08);
}

.integration-map-brand {
  grid-column: 1 / -1;
  display: flex;
  width: 130px;
  height: 82px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin: 0 auto 14px;
  border-radius: 9px;
  background: #1c4f8f;
  color: #fff;
  box-shadow: 0 10px 22px rgba(28, 79, 143, .2);
}

.integration-map-brand img {
  width: 34px;
}

.integration-map-brand span {
  font-size: 12px;
  font-weight: 800;
}

.integration-rail {
  display: none;
}

.integration-module {
  display: flex;
  min-height: 52px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid #cbd9e9;
  border-radius: 7px;
  background: #fff;
  color: #16202e;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
}

.integration-module b {
  color: #1c4f8f;
  font-size: 11px;
  font-weight: 800;
}

@media (max-width: 760px) {
  .integration-map {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 24px 14px;
  }
  .integration-map-brand {
    grid-column: 1 / -1;
    margin-bottom: 10px;
  }
}

.print-slot-image {
  overflow: hidden;
  border: 1px solid #d9e2ed;
  border-radius: 13px;
  background: #fff;
  box-shadow: var(--shadow);
}

.print-slot-image img {
  display: block;
  width: 100%;
  height: auto;
}

.print-slot-image .print-caption {
  display: block;
  padding: 12px 16px;
  margin: 0;
  border-top: 1px solid var(--line);
  background: #fbfcfe;
  color: #667085;
  font-size: 11px;
  font-weight: 600;
  text-align: left;
}

@media (max-width: 760px) {
  .print-slot-image {
    border-radius: 10px;
  }
  .print-slot-image .print-caption {
    padding: 10px 13px;
    font-size: 10.5px;
  }
}

/* =========================================================
   FORMULÁRIO DE CONTATO
   ========================================================= */

.contact-form {
  display: grid;
  gap: 14px;
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16);
}

.contact-form label {
  display: grid;
  gap: 7px;
}

.contact-form label span {
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
  font-weight: 700;
}

.contact-form input {
  width: 100%;
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 7px;
  outline: none;
  background: #fff;
  color: var(--ink);
  font-size: 13px;
  transition:
    border-color 0.2s,
    box-shadow 0.2s;
}

.contact-form input::placeholder {
  color: #98a2b3;
}

.contact-form input:focus {
  border-color: #9bb9dc;
  box-shadow: 0 0 0 3px rgba(155, 185, 220, 0.2);
}

.contact-form .button {
  width: 100%;
  margin-top: 4px;
}

.contact-form small {
  color: rgba(255, 255, 255, 0.58);
  font-size: 11px;
  line-height: 1.5;
}

.form-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 32px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  text-align: center;
}

.form-success svg {
  color: #9bb9dc;
}

.form-success strong {
  font-size: 18px;
}

.form-success p {
  max-width: 430px;
  margin: 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  line-height: 1.6;
}

@media (max-width: 760px) {
  .contact-form {
    padding: 20px;
  }
}

.cta-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(380px, 500px);
  align-items: center;
  gap: 70px;
}

.cta-copy {
  min-width: 0;
}

.cta-list {
  display: grid;
  gap: 10px;
  margin: 25px 0 0;
  padding: 0;
  list-style: none;
  color: rgba(255, 255, 255, 0.72);
  font-size: 13px;
  line-height: 1.5;
}

.cta-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.cta-list svg {
  flex: none;
  margin-top: 2px;
  color: #9bb9dc;
}

@media (max-width: 760px) {
  .cta-grid {
    grid-template-columns: 1fr;
    gap: 35px;
  }
}